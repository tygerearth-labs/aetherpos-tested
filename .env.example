# ==================== AETHER POS - Environment Variables ====================
# Copy this file to .env.local and fill in your values

# ── Database (PostgreSQL) ──
# Use Vercel Postgres, Neon, Supabase, or any PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ── NextAuth ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# Your Vercel deployment URL (e.g. https://aether-pos.vercel.app)
NEXTAUTH_URL="https://your-domain.vercel.app"

# ── Optional: AI Insights (z-ai-web-dev-sdk) ──
# If not set, AI insight generation will be disabled (non-fatal)
# ZAI_API_KEY="your-zai-api-key"