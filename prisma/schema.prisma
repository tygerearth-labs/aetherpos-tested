// ==================== AETHER POS SCHEMA ====================
// SQLite for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== OUTLET ====================
model Outlet {
  id           String   @id @default(cuid())
  name         String
  address      String?
  phone        String?
  accountType  String   @default("free") // free, pro, enterprise
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  products        Product[]
  customers       Customer[]
  categories      Category[]
  transactions    Transaction[]
  auditLogs       AuditLog[]
  setting         OutletSetting?
  promos          Promo[]
  crewPermissions CrewPermission[]
  productVariants ProductVariant[]
  stockTransfersFrom StockTransfer[] @relation("FromOutlet")
  stockTransfersTo   StockTransfer[] @relation("ToOutlet")
  stockTransfers     StockTransfer[]
}

// ==================== USER ====================
model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  password      String
  role          String   @default("CREW") // OWNER or CREW
  outletId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet          Outlet           @relation(fields: [outletId], references: [id])
  transactions    Transaction[]
  auditLogs       AuditLog[]
  crewPermission  CrewPermission?
  stockTransfers  StockTransfer[]

  @@unique([email, outletId])
}

// ==================== CATEGORY ====================
model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("zinc")
  outletId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet   Outlet     @relation(fields: [outletId], references: [id])
  products Product[]
  promos   Promo[]

  @@unique([name, outletId])
}

// ==================== PRODUCT ====================
model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String?
  barcode       String?
  hpp           Float    @default(0)
  price         Float
  bruto         Float    @default(0)
  netto         Float    @default(0)
  stock         Int      @default(0)
  lowStockAlert Int      @default(10)
  unit          String   @default("pcs")
  image         String?
  categoryId    String?
  outletId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hasVariants      Boolean        @default(false)
  outlet           Outlet           @relation(fields: [outletId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  transactionItems TransactionItem[]
  variants         ProductVariant[]
  stockTransfers   StockTransfer[]

  @@unique([name, outletId])
}

// ==================== PRODUCT VARIANT ====================
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  barcode   String?
  hpp       Float    @default(0)
  price     Float
  stock     Int      @default(0)
  outletId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  outlet           Outlet            @relation(fields: [outletId], references: [id])
  transactionItems TransactionItem[]
  stockTransfers   StockTransfer[]

  @@unique([name, productId])
}

// ==================== CUSTOMER ====================
model Customer {
  id          String   @id @default(cuid())
  name        String
  whatsapp    String
  totalSpend  Float    @default(0)
  points      Int      @default(0)
  outletId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet       Outlet       @relation(fields: [outletId], references: [id])
  transactions Transaction[]
  loyaltyLogs  LoyaltyLog[]

  @@unique([whatsapp, outletId])
}

// ==================== TRANSACTION ====================
model Transaction {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  subtotal      Float
  discount      Float    @default(0)
  pointsUsed    Int      @default(0)
  taxAmount     Float    @default(0)
  total         Float
  paymentMethod String
  paidAmount    Float    @default(0)
  change        Float    @default(0)
  note          String?
  outletId      String
  customerId    String?
  userId        String
  createdAt     DateTime @default(now())

  outlet           Outlet            @relation(fields: [outletId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  items            TransactionItem[]
  loyaltyLogs      LoyaltyLog[]
}

// ==================== TRANSACTION ITEM ====================
model TransactionItem {
  id             String      @id @default(cuid())
  productId      String?
  variantId      String?
  productName    String
  variantName    String?
  price          Float
  qty            Int
  subtotal       Float
  itemDiscount   Float       @default(0)
  hpp            Float
  transactionId  String

  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// ==================== LOYALTY LOG ====================
model LoyaltyLog {
  id             String    @id @default(cuid())
  type           String
  points         Int
  description    String
  customerId     String
  transactionId  String?
  createdAt      DateTime @default(now())

  customer    Customer    @relation(fields: [customerId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
}

// ==================== AUDIT LOG ====================
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  details     String?
  outletId    String
  userId      String
  createdAt   DateTime @default(now())

  outlet  Outlet  @relation(fields: [outletId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// ==================== OUTLET SETTING ====================
model OutletSetting {
  id      String @id @default(cuid())
  outletId String @unique

  paymentMethods String @default("CASH,QRIS")

  loyaltyEnabled          Boolean @default(true)
  loyaltyPointsPerAmount  Int     @default(10000)
  loyaltyPointValue       Int     @default(100)

  receiptBusinessName String @default("Aether POS")
  receiptAddress      String @default("")
  receiptPhone        String @default("")
  receiptFooter       String @default("Terima kasih atas kunjungan Anda!")
  receiptLogo         String @default("")

  ppnEnabled      Boolean @default(false)
  ppnRate         Float   @default(11)

  manualDiscountEnabled Boolean @default(false)

  themePrimaryColor String @default("emerald")

  telegramBotToken  String?
  telegramChatId   String?
  notifyOnTransaction Boolean @default(true)
  notifyOnCustomer   Boolean @default(true)
  notifyDailyReport  Boolean @default(true)
  notifyWeeklyReport Boolean @default(false)
  notifyMonthlyReport Boolean @default(true)
  notifyOnInsight     Boolean @default(true)

  outlet    Outlet   @relation(fields: [outletId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== PROMO ====================
model Promo {
  id          String   @id @default(cuid())
  name        String
  type        String
  value       Float
  minPurchase Float?
  maxDiscount Float?
  active      Boolean  @default(true)
  outletId    String
  buyMinQty   Int      @default(0)
  discountType String  @default("PERCENTAGE")
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet   Outlet   @relation(fields: [outletId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ==================== CREW PERMISSION ====================
model CrewPermission {
  id       String @id @default(cuid())
  userId   String @unique
  pages    String @default("pos")
  outletId String

  user   User   @relation(fields: [userId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== STOCK TRANSFER ====================
model StockTransfer {
  id              String   @id @default(cuid())
  productId       String?
  variantId       String?
  productName     String
  variantName     String?
  quantity        Int
  fromOutletId    String
  toOutletId      String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  reason          String?
  approvedBy      String?
  approvedAt      DateTime?
  completedAt     DateTime?
  outletId        String   // The outlet that initiated the transfer
  userId          String   // User who created the transfer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromOutlet  Outlet  @relation("FromOutlet", fields: [fromOutletId], references: [id])
  toOutlet    Outlet  @relation("ToOutlet", fields: [toOutletId], references: [id])
  user        User    @relation(fields: [userId], references: [id])
  outlet      Outlet  @relation(fields: [outletId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
}